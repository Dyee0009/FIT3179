{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "width": "container",
    "height": 300,
    "autosize": {
        "type": "fit",
        "contains": "padding"
    },
    "background": "transparent",
    "title": "Total Titles Released by Platform Type",
    "description": "Total Titles Released by Platform Type",
    "data": {
        "url": "https://raw.githubusercontent.com/Dyee0009/FIT3179/refs/heads/main/Data_Visualisation_2/data/d3-platform_summary.csv"
    },
    "mark": "bar",
    "encoding": {
        "x": {"field": "platform_type", "type": "nominal", "title": "Platform Type"},
        "y": {"field": "titles", "aggregate": "sum", "type": "quantitative", "title": "Total Titles"},
        "tooltip": [
            {"field": "platform_type", "type": "nominal", "title": "Platform Type:"},
            {"field": "titles", "aggregate": "sum", "type": "quantitative", "title": "Total Titles:", "format": ","}
        ]
    },
    "config": {
        "font": "Noto Sans"
    }
}