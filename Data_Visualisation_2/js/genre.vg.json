{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "width": "container",
    "height": 300,
    "autosize": {
        "type": "fit",
        "contains": "padding"
    },
    "background": "transparent",
    "title": "Top 3 Genres by Region",
    "description": "Top 3 Genres by Region",
    "data": {
        "url": "https://raw.githubusercontent.com/Dyee0009/FIT3179/refs/heads/main/Data_Visualisation_2/data/d2-top3_sales_by_continent_genre.csv"
    },
    "mark": "bar",
    "encoding": {
        "x": {"field": "continent", "type": "nominal", "title": "Continent"},
        "y": {"field": "sales", "type": "quantitative", "title": "Copies Sold (in Millions)"},
        "color": {"field": "genre", "type": "nominal", "title": "Genre",
                    "scale": {
                        "domain": ["Action", "Role-Playing", "Shooter", "Sports"],
                        "range": ["#1E88E5", "#FFC107", "#D81B60", "#004D40"]
                    }},
        "tooltip": [
            {"field": "continent", "type": "nominal", "title": "Continent:"},
            {"field": "sales", "type": "quantitative", "title": "Copies Sold (in Millions):", "format": ","},
            {"field": "genre", "type": "nominal", "title": "Genre:"}
        ]
    },
    "config": {
        "font": "Noto Sans"
    }
}