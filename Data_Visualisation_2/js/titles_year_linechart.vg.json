{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "width": "container",
    "height": 300,
    "autosize": {
        "type": "fit",
        "contains": "padding"
    },
    "background": "transparent",
    "title": "Total Titles Released by Year",
    "description": "Total Titles Released by Year",
    "data": {
        "url": "https://raw.githubusercontent.com/Dyee0009/FIT3179/refs/heads/main/Data_Visualisation_2/data/d3-yearly_trends.csv"
    },
    "transform": [{"filter": "datum.year <= 2024"}],
    "mark": "line",
    "encoding": {
        "x": {"field": "year", "type": "quantitative", "title": "Year", "axis": {"format": "d"}},
        "y": {"field": "titles_released", "type": "quantitative", "title": "Titles Released"},
         "tooltip": [
            {"field": "year", "type": "quantitative", "title": "Year:", "format": "d"},
            {"field": "titles_released", "type": "quantitative", "title": "Titles Released:", "format": ","}
        ]
    },
    "config": {
        "font": "Noto Sans"
    }
}