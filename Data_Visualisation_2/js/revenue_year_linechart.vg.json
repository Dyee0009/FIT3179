{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "width": "container",
    "height": 300,
    "autosize": {
        "type": "fit",
        "contains": "padding"
    },
    "background": "transparent",
    "title": "Estimated Revenue by Year (in Millions)",
    "description": "Estimated Revenue by Year (in Millions)",
    "data": {
        "url": "https://raw.githubusercontent.com/Dyee0009/FIT3179/refs/heads/main/Data_Visualisation_2/data/d3-yearly_trends.csv"
    },
    "transform": [
        {"filter": "datum.year <= 2024"},
        {"calculate": "datum.total_sales_m * datum.avg_launch_price", "as": "estimated_revenue_m"}
    ],
    "mark": "line",
    "encoding": {
        "x": {"field": "year", "type": "quantitative", "title": "Year", "axis": {"format": "d"}},
        "y": {"field": "estimated_revenue_m", "type": "quantitative", "title": "Estimated Revenue (in Millions)"},
         "tooltip": [
            {"field": "year", "type": "quantitative", "title": "Year:", "format": "d"},
            {"field": "avg_launch_price", "type": "quantitative", "title": "Average Launch Price:", "format": ","},
            {"field": "total_sales_m", "type": "quantitative", "title": "Copies Sold (in Millions):", "format": ","},
            {"field": "estimated_revenue_m", "type": "quantitative", "title": "Estimated Revenue (in Millions):", "format": ",.2f"}
        ]
    },
    "config": {
        "font": "Noto Sans"
    }
}