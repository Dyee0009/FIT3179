{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "width": "container",
    "height": 300,
    "autosize": {
        "type": "fit",
        "contains": "padding"
    },
    "background": "transparent",
    "title": "Estimated Revenue by Platform Type (in Millions)",
    "description": "Estimated Revenue by Platform Type (in Millions)",
    "data": {
        "url": "https://raw.githubusercontent.com/Dyee0009/FIT3179/refs/heads/main/Data_Visualisation_2/data/d3-platform_summary.csv"
    },
    "transform": [
        {"calculate": "datum.total_sales_m * datum.avg_launch_price", "as": "estimated_revenue_m"}
    ],
    "mark": "bar",
    "encoding": {
        "x": {"field": "platform_type", "type": "nominal", "title": "Platform Type"},
        "y": {"field": "estimated_revenue_m", "aggregate": "sum", "type": "quantitative", "title": "Estimated Revenue (in Millions)"},
         "tooltip": [
            {"field": "platform_type", "type": "nominal", "title": "Platform Type:"},
            {"field": "avg_launch_price", "type": "quantitative", "title": "Average Launch Price:", "format": ","},
            {"field": "total_sales_m", "type": "quantitative", "title": "Copies Sold (in Millions):", "format": ","},
            {"field": "estimated_revenue_m", "aggregate": "sum", "type": "quantitative", "title": "Estimated Revenue (in Millions):", "format": ",.2f"}
        ]
    },
    "config": {
        "font": "Noto Sans"
    }
}