{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "width": "container",
    "height": 300,
    "autosize": {
        "type": "fit",
        "contains": "padding"
    },
    "background": "transparent",
    "title": "Most Popular Genre by Region by Copies Sold",
    "description": "Most Popular Genre by Region by Copies Sold",
    "projection": {"type": "equalEarth"},
    "data": {
        "url": "https://raw.githubusercontent.com/Dyee0009/FIT3179/refs/heads/main/Data_Visualisation_2/data/ne_110m_admin_0_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
    },
    "layer": [
        {
        "transform": [
            {
            "calculate": "'Data is not available in ' + datum.properties.CONTINENT",
            "as": "note"
            }
        ],
        "mark": {"type": "geoshape", "fill": "lightgray", "stroke": "white"},
        "encoding": {"tooltip": {"field": "note"}}
        },
        {
        "data": {
            "url": "https://raw.githubusercontent.com/Dyee0009/FIT3179/refs/heads/main/Data_Visualisation_2/data/oceans.topojson",
            "format": {"type": "topojson", "feature": "oceans"}
        },
        "mark": {"type": "geoshape", "fill": "skyblue"}
        },
        {
        "data": {
            "url": "https://raw.githubusercontent.com/Dyee0009/FIT3179/refs/heads/main/Data_Visualisation_2/data/WorldMapWithGraticules.topojson",
            "format": {"type": "topojson", "feature": "ne_110m_graticules_30"}
        },
        "mark": {"type": "geoshape", "fill": null, "stroke": "lightgray"}
        },
        {
        "transform": [
            {
            "calculate": "datum.properties.NAME == 'Japan' ? 'Japan' : datum.properties.CONTINENT",
            "as": "custom_region"
            },
            {
            "lookup": "custom_region",
            "from": {
                "data": {
                "url": "https://raw.githubusercontent.com/Dyee0009/FIT3179/refs/heads/main/Data_Visualisation_2/data/d2-max_genre_sales_by_continent.csv"
                },
                "key": "continent",
                "fields": ["continent",	"genre", "sales", "latitude", "longitude"]
            }
            }
        ],
        "mark": {"type": "circle"},
        "encoding": {
            "longitude": {"field": "longitude", "type": "quantitative"},
            "latitude": {"field": "latitude", "type": "quantitative"},
            "size": {
                "field": "sales",
                "type": "quantitative",
                "title": "Total Sales"
            },
            "color": {
            "field": "genre",
            "type": "nominal",
            "title": "Genre"
            },
            "tooltip": [
            {"field": "custom_region", "type": "nominal", "title": "Continent:"},
            {"field": "sales", "type": "quantitative", "title": "Total Sales (in Millions):", "format": ","},
            {"field": "genre", "type": "nominal", "title": "Genre:"}
            ]
        }
        }
    ],
    "config": {
        "font": "Noto Sans"
    }
}