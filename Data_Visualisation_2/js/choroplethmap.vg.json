{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "width": "container",
    "height": 300,
    "autosize": {
        "type": "fit",
        "contains": "padding"
    },
    "background": "transparent",
    "title": "Copies Sold by Region",
    "description": "Copies Sold by Region",
    "projection": {"type": "equalEarth"},
    "data": {
        "url": "https://raw.githubusercontent.com/Dyee0009/FIT3179/refs/heads/main/Data_Visualisation_2/data/ne_110m.json",
        "format":  {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
    },
    "transform": [
        {
            "lookup": "properties.CONTINENT",
            "from": {
                "data": {
                    "url": "https://raw.githubusercontent.com/Dyee0009/FIT3179/refs/heads/main/Data_Visualisation_2/data/d2-total_sales_by_continent.csv"
                },
                "key": "continent",
                "fields": "sales"
            }
        }
    ],
    "mark": {"type": "geoshape"},
    "encoding": {
        "color": {
            "field": "sales",
            "type": "quantitative"
        },
        "tooltip": [
            {"field": "properties.CONTINENT", "type": "nominal", "title": "Continent:"},
            {"field": "sales", "type": "quantitative", "title": "Copies Sold (in Millions):", "format": ","}
        ]
    },
    "config": {
        "font": "Noto Sans"
    }
}