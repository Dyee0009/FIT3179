{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "width": "container",
    "height": 300,
    "autosize": {
        "type": "fit",
        "contains": "padding"
    },
    "background": "transparent",
    "title": "Reach of Top Publisher Regions",
    "description": "Reach of Top Publisher Regions",
    "projection": {"type": "equalEarth"},
    "layer": [
        {
        "data": {
            "url": "https://raw.githubusercontent.com/Dyee0009/FIT3179/refs/heads/main/Data_Visualisation_2/data/ne_110m_admin_0_countries.topojson",
            "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
        },
        "mark": {"type": "geoshape", "fill": "lightgray", "stroke": "white"}
        },
        {
        "data": {
            "url": "https://raw.githubusercontent.com/Dyee0009/FIT3179/refs/heads/main/Data_Visualisation_2/data/oceans.topojson",
            "format": {"type": "topojson", "feature": "oceans"}
        },
        "mark": {"type": "geoshape", "fill": "skyblue"}
        },
        {
        "data": {
            "url": "https://raw.githubusercontent.com/Dyee0009/FIT3179/refs/heads/main/Data_Visualisation_2/data/WorldMapWithGraticules.topojson",
            "format": {"type": "topojson", "feature": "ne_110m_graticules_30"}
        },
        "mark": {"type": "geoshape", "fill": null, "stroke": "lightgray"}
        },
        {
            "data": {
            "url": "https://raw.githubusercontent.com/Dyee0009/FIT3179/refs/heads/main/Data_Visualisation_2/data/d3-sales_by_top_publisher_region.csv"
            },
            "projection": {
            "type": "equalEarth"
            },
            "mark": {"type": "circle", "size": 80, "color": "red"},
            "encoding": {
            "longitude": {
                "field": "org_longitude",
                "type": "quantitative"
            },
            "latitude": {
                "field": "org_latitude",
                "type": "quantitative"
            },
            "tooltip": [
            {"field": "publisher_region", "type": "nominal", "title": "Publisher Region:"}
            ]
            }
        },
        {
            "data": {
            "url": "https://raw.githubusercontent.com/Dyee0009/FIT3179/refs/heads/main/Data_Visualisation_2/data/d3-sales_by_top_publisher_region.csv"
            },
            "projection": {
            "type": "equalEarth"
            },
            "mark": {"type": "circle", "size": 80, "color": "blue"},
            "encoding": {
            "longitude": {
                "field": "dest_longitude",
                "type": "quantitative"
            },
            "latitude": {
                "field": "dest_latitude",
                "type": "quantitative"
            },
            "tooltip": [
            {"field": "continent", "type": "nominal", "title": "Continent:"}
            ]
            }
        },
        {
            "data": {
            "url": "https://raw.githubusercontent.com/Dyee0009/FIT3179/refs/heads/main/Data_Visualisation_2/data/d3-sales_by_top_publisher_region.csv"
            },
            "projection": {
            "type": "equalEarth"
            },
            "mark": "rule",
            "encoding": {
            "longitude": {
                "field": "org_longitude",
                "type": "quantitative"
            },
            "latitude": {
                "field": "org_latitude",
                "type": "quantitative"
            },
            "longitude2": {
                "field": "dest_longitude",
                "type": "quantitative"
            },
            "latitude2": {
                "field": "dest_latitude",
                "type": "quantitative"
            },
            "size": {
                "field": "sales",
                "type": "quantitative",
                "title": "Copies Sold (in Millions)"
            },
            "tooltip": [
            {"field": "continent", "type": "nominal", "title": "Continent:"},
            {"field": "sales", "type": "quantitative", "title": "Copies Sold (in Millions):", "format": ","},
            {"field": "publisher_region", "type": "nominal", "title": "Top Publisher Region:"}
            ]
            }
        }
    ],
    "config": {
        "font": "Noto Sans"
    }
}