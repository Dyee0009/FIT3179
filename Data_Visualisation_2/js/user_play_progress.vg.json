{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "width": "container",
    "height": 300,
    "autosize": {
        "type": "fit",
        "contains": "padding"
    },
    "background": "transparent",
    "title": "User Play Progress by Game Release Year",
    "description": "User Play Progress by Game Release Year",
    "data": {
        "url": "https://raw.githubusercontent.com/Dyee0009/FIT3179/refs/heads/main/Data_Visualisation_2/data/d1-user_data.csv"
    },
    "transform": [{"filter": "datum.year <= 2022"}],
    "mark": "line",
    "encoding": {
        "x": {"field": "year", "type": "quantitative", "title": "Year", "axis": {"format": "d"}},
        "y": {"field": "total", "type": "quantitative", "title": "Entries"},
        "color": {"field": "play_progress", "type": "nominal", "title": "Status"},
        "tooltip": [
            {"field": "year", "type": "quantitative", "title": "Year:", "format": "d"},
            {"field": "total", "type": "quantitative", "title": "Entries:", "format": ","},
            {"field": "play_progress", "type": "nominal", "title": "Status:"}
        ]
    },
    "config": {
        "font": "Noto Sans"
    }
}